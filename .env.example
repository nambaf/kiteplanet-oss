# Kiteplanet — la demo funziona anche senza nessuna chiave. I provider che
# richiedono una key vanno in graceful degradation (badge "API key required"
# nella UI) finché non aggiungi la tua. Nessun fallback ad endpoint a pagamento.

# --- User-Agent globale -----------------------------------------------------
# Inviato a tutti i provider HTTP. Wikimedia blocca client con UA generico,
# Open-Meteo/NDBC/NHC apprezzano un'identificazione. Personalizza nei fork.
# KITEPLANET_UA=Kiteplanet/1.0.0 (+https://github.com/nambaf/kiteplanet-oss)

# --- Open-Meteo (no key) ----------------------------------------------------
# Forecast vento/onda, marine (SST, onda). Endpoint pubblici e gratuiti.
# OPEN_METEO_BASE=https://api.open-meteo.com/v1
# OPEN_METEO_MARINE_BASE=https://marine-api.open-meteo.com/v1
# Timeout (ms) per singola chiamata Open-Meteo. Default 8000.
# OPEN_METEO_TIMEOUT_MS=8000

# --- NOAA NDBC (no key) -----------------------------------------------------
# Osservazioni real-time dalle boe oceaniche NOAA.
# NDBC_BASE=https://www.ndbc.noaa.gov/data/realtime2

# --- NHC tropical cyclones (no key) -----------------------------------------
# Feed JSON dei cicloni tropicali attivi.
# NHC_GEOJSON=https://www.nhc.noaa.gov/CurrentStorms.json

# --- Wikipedia REST (no key) ------------------------------------------------
# Summary enciclopedico per spot. Override solo per mirror/test.
# WIKIPEDIA_BASE_IT=https://it.wikipedia.org/api/rest_v1
# WIKIPEDIA_BASE_EN=https://en.wikipedia.org/api/rest_v1

# --- Stormglass (key, free 10 req/giorno) -----------------------------------
# Maree (extremes). Whitelist: si attiva SOLO sugli spot con
# refs.stormglassEnabled=true (vedi src/data/spots/*.ts).
# Registrati su https://stormglass.io
STORMGLASS_API_KEY=
# STORMGLASS_BASE=https://api.stormglass.io/v2

# --- UI flags ---------------------------------------------------------------
# Mostra la strip "sorgenti dati" sotto la mappa in home. "0" la nasconde.
NEXT_PUBLIC_SHOW_DATA_SOURCES_STRIP=1
# Mostra il pannello "Sorgenti per questo spot" in fondo alle pagine spot.
NEXT_PUBLIC_SHOW_SPOT_SOURCES_PANEL=1
# Lingua di default per la sezione data-sources ("it" o "en"). Cookie 'lang' override.
NEXT_PUBLIC_DEFAULT_LANG=it
