{
  "name": "kiteplanet",
  "version": "1.0.0",
  "private": true,
  "description": "Find the right kitesurf spot. Wind, wave and tide from open data sources on an interactive globe. No login, no database, no mandatory API keys.",
  "license": "MIT",
  "keywords": [
    "kitesurf",
    "kiteboarding",
    "wind",
    "forecast",
    "open-data",
    "three.js",
    "next.js",
    "pwa"
  ],
  "author": "Marco Di Felice",
  "repository": {
    "type": "git",
    "url": "https://github.com/nambaf/kiteplanet-oss"
  },
  "homepage": "https://github.com/nambaf/kiteplanet-oss#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "earcut": "^3.0.2",
    "lucide-react": "^1.16.0",
    "next": "^15.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/earcut": "^3.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.184.1",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.3",
    "postcss": "^8.4.49",
    "standard-version": "^9.5.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
